{
  "name": "qc1-stm32-tools",
  "displayName": "QC1 STM32F103 CMake Tools",
  "description": "Extension STM32F103 autonome avec moteur de build CMake intégré",
  "version": "0.3.1",
  "publisher": "Mistral400",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matisserheaumeviale-ux/qc1-stm32-tools.git"
  },
  "files": [
    "out/**",
    "media/**",
    "resources/cmake/**",
    "QC1_CODES.md",
    "AUDIT_PORTABILITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "extensionDependencies": [
    "ms-vscode.cmake-tools",
    "mylonics.embedded-build-tools"
  ],
  "activationEvents": [
    "onView:qc1.panel",
    "workspaceContains:CMakeLists.txt",
    "workspaceContains:**/*.ioc",
    "workspaceContains:**/*.eww",
    "workspaceContains:**/*.ewp",
    "onCommand:qc1.build",
    "onCommand:qc1.flash",
    "onCommand:qc1.run",
    "onCommand:qc1.status",
    "onCommand:qc1.createDiagnosticReport"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qc1",
          "title": "QC1 STM32",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "qc1": [
        {
          "id": "qc1.panel",
          "name": "STM32 Tools",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "qc1.build",
        "title": "Build Project",
        "category": "QC1 STM32",
        "icon": "$(tools)"
      },
      {
        "command": "qc1.clean",
        "title": "Clean Project",
        "category": "QC1 STM32",
        "icon": "$(trash)"
      },
      {
        "command": "qc1.rebuild",
        "title": "Rebuild Project",
        "category": "QC1 STM32",
        "icon": "$(sync)"
      },
      {
        "command": "qc1.tsmake",
        "title": "QC1: Test Build"
      },
      {
        "command": "qc1.flash",
        "title": "Flash STM32",
        "category": "QC1 STM32",
        "icon": "$(debug-start)"
      },
      {
        "command": "qc1.run",
        "title": "Build + Flash + Status",
        "category": "QC1 STM32",
        "icon": "$(play)"
      },
      {
        "command": "qc1.health",
        "title": "QC1: Health Check"
      },
      {
        "command": "qc1.status",
        "title": "Show STM32 Status",
        "category": "QC1 STM32",
        "icon": "$(pulse)"
      },
      {
        "command": "qc1.error",
        "title": "QC1: Errors"
      },
      {
        "command": "qc1.detectStlink",
        "title": "Detect ST-Link",
        "category": "QC1 STM32",
        "icon": "$(search)"
      },
      {
        "command": "qc1.openSerial",
        "title": "Open Serial Monitor",
        "category": "QC1 STM32",
        "icon": "$(plug)"
      },
      {
        "command": "qc1.startOpenOcd",
        "title": "Start OpenOCD",
        "category": "QC1 STM32",
        "icon": "$(radio-tower)"
      },
      {
        "command": "qc1.configure",
        "title": "Configure QC1 STM32 Tools",
        "category": "QC1 STM32",
        "icon": "$(settings-gear)"
      },
      {
        "command": "qc1.createDiagnosticReport",
        "title": "Créer un rapport de diagnostic",
        "category": "QC1 STM32",
        "icon": "$(report)"
      },
      {
        "command": "qc1.refresh",
        "title": "Refresh QC1 Panel",
        "category": "QC1 STM32",
        "icon": "$(refresh)"
      },
      {
        "command": "qc1.dev",
        "title": "QC1: Dev Mode"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "qc1.build" },
        { "command": "qc1.clean" },
        { "command": "qc1.rebuild" },
        { "command": "qc1.flash" },
        { "command": "qc1.run" },
        { "command": "qc1.status" },
        { "command": "qc1.detectStlink" },
        { "command": "qc1.openSerial" },
        { "command": "qc1.startOpenOcd" },
        { "command": "qc1.configure" },
        { "command": "qc1.createDiagnosticReport" }
      ],
      "view/title": [
        {
          "command": "qc1.refresh",
          "when": "view == qc1.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "qc1.build",
          "when": "view == qc1.panel",
          "group": "inline"
        },
        {
          "command": "qc1.flash",
          "when": "view == qc1.panel",
          "group": "inline"
        }
      ]
    },
    "configuration": [
      {
        "title": "QC1 STM32 Tools",
        "properties": {
          "qc1.toolPaths": {
            "type": "object",
            "default": {},
            "additionalProperties": { "type": "string" },
            "scope": "resource",
            "description": "Chemins explicites des outils de diagnostic (ex.: arm-none-eabi-gdb, STM32CubeProgrammer, J-Link, Python)."
          },
          "qc1.elfPath": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "Artefact ELF explicite (relatif au projet ou absolu). Vide: File API CMake si disponible, puis nom de cible."
          },
          "qc1.targetMcu": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "MCU déclaré, utilisé comme preuve dans le rapport et pour détecter les conflits."
          },
          "qc1.projectPath": {
            "type": "string",
            "default": "",
            "description": "Chemin du dossier projet STM32. Vide = auto-détection depuis le workspace."
          },
          "qc1.cmakePath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers l'exécutable CMake. Vide = auto-détection dans le PATH ou via CMake Tools."
          },
          "qc1.buildDirectory": {
            "type": "string",
            "default": "build/qc1",
            "description": "Dossier de build CMake relatif au projet STM32."
          },
          "qc1.buildType": {
            "type": "string",
            "enum": [
              "Debug",
              "Release",
              "RelWithDebInfo",
              "MinSizeRel"
            ],
            "default": "Debug",
            "description": "Configuration CMake utilisée par QC1."
          },
          "qc1.compilerPath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers arm-none-eabi-gcc. Vide = auto-détection dans le PATH."
          },
          "qc1.openocdPath": {
            "type": "string",
            "default": "",
            "description": "Chemin vers openocd. Vide = auto-détection dans le PATH."
          },
          "qc1.serialPort": {
            "type": "string",
            "default": "",
            "description": "Serial port used for STM32 UART"
          },
          "qc1.baudRate": {
            "type": "number",
            "default": 19200,
            "description": "UART baud rate"
          },
          "qc1.stlinkPath": {
            "type": "string",
            "default": "st-info",
            "description": "Path to ST-Link command line tool"
          },
          "qc1.autoDetectProject": {
            "type": "boolean",
            "default": true,
            "description": "Automatically detect STM32 project files"
          },
          "qc1.autoClearOutput": {
            "type": "boolean",
            "default": false,
            "description": "Clear output before running"
          },
          "qc1.showTimestamps": {
            "type": "boolean",
            "default": true,
            "description": "Show timestamps in output"
          },
          "qc1.outputMaxLines": {
            "type": "number",
            "default": 500,
            "minimum": 50,
            "maximum": 5000,
            "description": "Max output lines"
          },
          "qc1.compactMode": {
            "type": "boolean",
            "default": false,
            "description": "Compact UI mode"
          },
          "qc1.autoRefreshStatus": {
            "type": "boolean",
            "default": true,
            "description": "Auto refresh status"
          },
          "qc1.enablePointerVisualizer": {
            "type": "boolean",
            "default": true,
            "description": "Enable pointer visualizer"
          },
          "qc1.pointerVisualizerMaxDepth": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "Pointer depth"
          },
          "qc1.visualizerTheme": {
            "type": "string",
            "enum": [
              "auto",
              "dark",
              "light"
            ],
            "default": "auto",
            "description": "Visualizer theme"
          }
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "compile": "node ./node_modules/typescript/bin/tsc",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.10.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
