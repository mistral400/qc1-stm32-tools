{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qc1:regix:database-schema:1.0.0",
  "title": "REGIX peripheral database",
  "description": "Schema version 1.0.0 for the offline, provenance-carrying REGIX device and register catalog.",
  "type": "object",
  "required": ["schemaVersion", "databaseVersion", "sources", "core", "cmsis", "deviceModels", "packages", "peripheralBases", "registers"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "databaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
    "core": {"type": "string"},
    "cmsis": {"type": "object", "required": ["deviceHeader", "deviceHeaderVersion", "deviceDefine", "sourceId"], "properties": {"deviceHeader": {"type": "string"}, "deviceHeaderVersion": {"type": "string"}, "deviceDefine": {"type": "string"}, "sourceId": {"type": "string"}}, "additionalProperties": false},
    "deviceModels": {"type": "array", "items": {"type": "object", "required": ["id", "partNumber", "family", "cmsisClass", "core", "flashKiB", "sramKiB", "packageId", "status", "sourceIds"], "properties": {"id": {"type": "string"}, "partNumber": {"type": "string"}, "family": {"type": "string"}, "cmsisClass": {"type": "string"}, "core": {"type": "string"}, "flashKiB": {"type": "integer", "minimum": 1}, "sramKiB": {"type": "integer", "minimum": 1}, "packageId": {"type": "string"}, "status": {"enum": ["course-reference", "neighbor-model"]}, "sourceIds": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "packages": {"type": "array", "items": {"type": "object", "required": ["id", "name", "pinCount", "sourceId", "pins"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "pinCount": {"type": "integer", "minimum": 1}, "sourceId": {"type": "string"}, "pins": {"type": "array", "items": {"$ref": "#/$defs/packagePin"}}}, "additionalProperties": false}},
    "peripheralBases": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$"}},
    "registers": {"type": "object", "required": ["RCC", "GPIO"], "properties": {"RCC": {"type": "array", "items": {"$ref": "#/$defs/registerTemplate"}}, "GPIO": {"type": "array", "items": {"$ref": "#/$defs/registerTemplate"}}}, "additionalProperties": false}
  },
  "$defs": {
    "source": {"type": "object", "required": ["id", "title", "document", "revision", "url", "license"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "document": {"type": "string"}, "revision": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "license": {"type": "string"}}, "additionalProperties": false},
    "field": {"type": "object", "required": ["name", "lsb", "width", "access"], "properties": {"name": {"type": "string"}, "lsb": {"type": "integer", "minimum": 0, "maximum": 31}, "width": {"type": "integer", "minimum": 1, "maximum": 32}, "access": {"enum": ["read-only", "read-write", "write-only", "write-one-to-clear"]}, "description": {"type": "string"}}, "additionalProperties": false},
    "registerTemplate": {"type": "object", "required": ["name", "offset", "width", "access", "readSideEffects", "writeSideEffects", "writeSemantics", "sourceIds"], "properties": {"name": {"type": "string"}, "offset": {"type": "integer", "minimum": 0}, "width": {"const": 32}, "access": {"enum": ["read-only", "read-write", "write-only", "write-one-to-clear"]}, "readSideEffects": {"type": "boolean"}, "writeSideEffects": {"type": "boolean"}, "writeSemantics": {"enum": ["normal", "command", "write-one-to-clear"]}, "fieldLayout": {"type": "string"}, "sourceIds": {"type": "array", "items": {"type": "string"}}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}}, "additionalProperties": false},
    "packagePin": {"type": "object", "required": ["name", "physicalPin", "port", "index"], "properties": {"name": {"type": "string"}, "physicalPin": {"type": "integer", "minimum": 1}, "port": {"type": "string", "pattern": "^[A-G]$"}, "index": {"type": "integer", "minimum": 0, "maximum": 15}, "maxOutputMHz": {"type": "number", "exclusiveMinimum": 0}, "maxLoadPf": {"type": "number", "exclusiveMinimum": 0}, "maxSinkCurrentMilliamp": {"type": "number", "exclusiveMinimum": 0}, "canSourceCurrent": {"type": "boolean"}, "electricalNote": {"type": "string"}, "remapRequired": {"type": "string"}, "defaultFunction": {"type": "string"}, "alternateFunction": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
